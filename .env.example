# OpenID Connect endpoint base of the identity provider. Leave empty to log in
# with Galene usernames and passwords instead.
VITE_SSO=https://sso.example.org/realms/example/protocol/openid-connect
# OpenID Connect client id.
VITE_CLIENT=galene
# Galene group that holds the rooms, with a trailing slash.
VITE_GROUP=meet/
